{
  "name": "local-frame-studio",
  "version": "1.4.12",
  "private": true,
  "author": "LocalFrame",
  "description": "本机与云端影像创作空间，整合图片、视频、三维预览与后期制作",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "three": "^0.180.0"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "cn.localframe.studio",
    "productName": "LocalFrame 影像创作",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packaging/发行说明.txt",
        "to": "docs/发行说明.txt"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/localframe-logo-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LocalFrame-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LocalFrame 影像创作",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@44.4.5": true
  }
}
